# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามจริง
DATABASE_URL="postgresql://supervision:supervision@localhost:5432/supervision?schema=public"

# Auth (เชื่อม SSO มหาวิทยาลัยภายหลัง)
AUTH_SECRET="change-me-in-production"

# File storage (NAS/MinIO/S3) — ใช้ในเฟสอัปโหลดหลักฐาน
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
